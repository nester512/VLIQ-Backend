    "react-router-dom": "^7.18.4",
    "vaul": "^1.1.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@hey-api/openapi-ts": "^0.99.0",
