{
  email {$CADDY_EMAIL:admin@example.com}
  # Dev default: CADDY_TLS_DIRECTIVE=internal -> self-signed local CA.
  # Prod: set CADDY_TLS_DIRECTIVE to your email -> `tls <email>`, which makes
  #       Caddy provision a trusted Let's Encrypt cert automatically.
  #       Do NOT use `auto` here — it is not a valid tls value.
}

{$CADDY_HOSTNAME:vliq.local} {
  tls {$CADDY_TLS_DIRECTIVE:internal}

  encode gzip zstd

  handle /api/* {
    reverse_proxy backend:8000
  }

  handle {
    reverse_proxy frontend:80
  }

  log {
    output stdout
    format json
  }
}
