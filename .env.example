# Template for the root .env (read by docker compose and by the backend).
# Copy to .env and replace placeholders. Never commit real values.
# Generate secrets with e.g.: openssl rand -hex 32
# Every environment (local / stage / production) gets its OWN secrets and its
# OWN Telegram bot: initData is signed with the bot token.
POSTGRES__POSTGRES_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/vliq
PORT=8000
# local | dev | qa | test | prod. `prod` disables the DEV-only POST /auth/login
# and Swagger. Any internet-facing environment (stage, production) must use prod.
ENV=local

# JWT (also signs receipt-image URLs and upload sessions)
JWT_SECRET_SALT=please-change-me-to-a-long-random-string
# Fernet key for payout requisites:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# PAYOUT_ENCRYPTION_KEY=your_fernet_key_here
# CORS_ORIGINS=["https://your-host.example"]

# Telegram bot
TG_BOT_TOKEN=your_bot_token_here
TMA_URL=https://your-host.example
# polling (default; used in production and stage) | webhook
BOT_MODE=polling
# BOT_WEBHOOK_HOST=your-host.example
# BOT_WEBHOOK_SECRET=your_webhook_secret_here
# BOT_WEBHOOK_PORT=8081

# Receipt checking: OFD_PROVIDER = fake | proverkacheka | real | ofd_ru,
# OCR_MODE = demo | full
OFD_PROVIDER=fake
OCR_MODE=demo
# PROVERKACHEKA_TOKEN=your_proverkacheka_token_here
# PROVERKACHEKA_BASE_URL=https://proverkacheka.com/api/v1
# OFD_TIMEOUT_SECONDS=10
# OFD_RETRY_MAX_ATTEMPTS=3

# Receipt storage (docker compose sets RECEIPT_STORAGE=s3 and S3_ENDPOINT_URL)
# RECEIPT_STORAGE=local
# RECEIPT_STORAGE_DIR=var/receipts
# S3_BUCKET=vliq-receipts
# S3_ACCESS_KEY=your_s3_access_key_here
# S3_SECRET_KEY=your_s3_secret_key_here
# S3_REGION=us-east-1
# S3_PREFIX=receipts/

# Demo seed (sellers/receipts/payouts from backend/seed_demo.sql).
# OFF by default — on prod a restart must not re-create demo data.
# Set to true for local dev so the mock login (12345) has demo receipts.
# The stage overlay forces true, the production overlay forces false.
SEED_DEMO=true

# Reverse proxy (Caddy). CADDY_TLS_DIRECTIVE: `internal` = self-signed (dev),
# an e-mail address = Let's Encrypt certificate.
CADDY_HOSTNAME=vliq.local
CADDY_TLS_DIRECTIVE=internal
CADDY_EMAIL=admin@example.com

# Monitoring (production only)
# GRAFANA_USER=admin
# GRAFANA_PASSWORD=your_grafana_password_here

# --- Stage stand only (docker-compose.stage.yml, see docs/CI-CD.md) ---
# STAGE_HOSTNAME=stage.example.com
# POSTGRES_PASSWORD=your_stage_postgres_password_here
# MINIO_ROOT_USER=your_stage_minio_user_here
# MINIO_ROOT_PASSWORD=your_stage_minio_password_here
# Only when another reverse proxy owns ports 80/443 on the stage host:
# STAGE_CADDY_SITE=http://stage.example.com
# STAGE_HTTP_BIND=127.0.0.1:8088
# STAGE_HTTPS_BIND=127.0.0.1:8443
# STAGE_APP_ENV=prod
