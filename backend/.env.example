# Copy to .env for local dev.
# DB credentials must match docker-compose.yml (user=vliq, password=vliq_dev, db=vliq).
POSTGRES__POSTGRES_URL=postgresql+asyncpg://vliq:vliq_dev@localhost:5432/vliq

PORT=8000
ENV=local

# JWT — replace with a long random secret in staging/prod.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_SALT=please-change-me-to-a-long-random-string

# Telegram Bot token — required for TMA initData HMAC verification and notifications.
TG_BOT_TOKEN=

# ---------------------------------------------------------------------------
# Telegram Bot runtime mode
# ---------------------------------------------------------------------------

# polling (default) — long polling; works without HTTPS; ideal for local dev.
# webhook           — aiohttp server on BOT_WEBHOOK_PORT; requires HTTPS (Caddy) + Caddyfile route.
BOT_MODE=polling

# Public hostname used to build the webhook URL (must match CADDY_HOSTNAME).
# Only required when BOT_MODE=webhook.
BOT_WEBHOOK_HOST=vliq.local

# Random secret that appears in the webhook URL path (basic auth-by-obscurity).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
# NEVER commit a real secret to git.
BOT_WEBHOOK_SECRET=change-me

# Internal port the bot's aiohttp server listens on inside the container.
# Caddy routes /tg-webhook/* → bot:BOT_WEBHOOK_PORT.
BOT_WEBHOOK_PORT=8081

# Fernet key for encrypting payout_account in the DB (H4).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PAYOUT_ENCRYPTION_KEY=

# Redis URL — must match the redis service in docker-compose.yml (default port 6379).
# Used for rate limiting (SlowAPI) and idempotency key storage (payout requests).
REDIS_URL=redis://localhost:6379/0

# OFD provider: "fake" (no external calls, dev/test), "proverkacheka", "real", or "ofd_ru".
OFD_PROVIDER=fake

# Required when OFD_PROVIDER=proverkacheka.
# Register at https://proverkacheka.com — free tier (~100 req/month).
# NEVER commit a real token to git.
# PROVERKACHEKA_TOKEN=

# Base URL for proverkacheka.com (override only for proxies or staging mirrors).
# PROVERKACHEKA_BASE_URL=https://proverkacheka.com/api/v1

# OFD retry / timeout configuration (optional — defaults are safe for most deployments).
# OFD_TIMEOUT_SECONDS=10
# OFD_RETRY_MAX_ATTEMPTS=3

# OCR pipeline mode: "demo" skips QR/OFD and grants a fixed 250-bonus on upload.
# Use "full" in production.
OCR_MODE=demo

# CORS allowed origins — JSON array. Leave empty for wildcard (dev only).
# Example: CORS_ORIGINS='["https://app.vliq.ru"]'
CORS_ORIGINS=[]

# ---------------------------------------------------------------------------
# Receipt file storage
# ---------------------------------------------------------------------------

# Storage backend: "local" (filesystem) or "s3" (MinIO / AWS S3 / Yandex OS).
RECEIPT_STORAGE=local

# Local storage directory — used when RECEIPT_STORAGE=local.
RECEIPT_STORAGE_DIR=var/receipts

# S3 / MinIO settings — used when RECEIPT_STORAGE=s3.
S3_BUCKET=vliq-receipts

# S3 endpoint URL.
# Local MinIO: http://localhost:9000
# AWS S3: leave empty (or remove the line entirely).
# Yandex Object Storage: https://storage.yandexcloud.net
S3_ENDPOINT_URL=http://localhost:9000

# DEV DEFAULTS — replace with real credentials for staging/prod.
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

S3_REGION=us-east-1
S3_PREFIX=receipts/

# --- HTTPS / Caddy reverse proxy ---
CADDY_HOSTNAME=vliq.local
# Dev: 'internal' uses Caddy's local CA. Prod: replace with your email for Let's Encrypt, e.g. 'tls user@example.com'.
CADDY_TLS_DIRECTIVE=internal
CADDY_EMAIL=admin@example.com

# Observability
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
